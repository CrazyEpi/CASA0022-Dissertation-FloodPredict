# Copy this file to .env on the server and fill in real values.
# Do not commit real keys.

HOST=0.0.0.0
PORT=8080
SITE_ID=house_mill
RUN_MODE=once
BACKGROUND_LOOP=0
USE_LIVE_API=1
ALLOW_HISTORY_CSV_FALLBACK=0
ALLOW_SHORT_HISTORY_PAD=1
LIVE_END_UTC=

# Local model artifacts.
HISTORY_CSV=model/history_reference_15min.csv
MODEL_CHECKPOINT=model/checkpoint_15min.pth
USE_GPU=0
PYTHONUNBUFFERED=1
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TORCH_NUM_THREADS=1
TORCH_NUM_INTEROP_THREADS=1

# Admiralty / tide.
ADMIRALTY_API_KEY=
ADMIRALTY_STATION_NAME=Sheerness
ADMIRALTY_STATION_ID=Sheerness
ADMIRALTY_STATIONS_ENDPOINT=https://admiraltyapi.azure-api.net/uktidalapi/api/V1/Stations
ADMIRALTY_TIDAL_EVENTS_ENDPOINT_TEMPLATE=https://admiraltyapi.azure-api.net/uktidalapi/api/V1/Stations/{station_id}/TidalEvents
ADMIRALTY_TIDAL_EVENTS_QUERY=
REQUIRE_TIDE_API=0
TIDE_SOURCE=auto
TIDE_FLOOD_MONITORING_MEASURE_ID=0001-level-tidal_level-i-15_min-mAOD

# Rainfall. Open-Meteo is used when EA_RAIN_MEASURE_IDS is empty.
RAIN_SOURCE=auto
EA_RAIN_MEASURE_IDS=
REQUIRE_RAIN_API=0
EA_READINGS_LIMIT=100000
OPEN_METEO_LAT=51.527
OPEN_METEO_LONG=-0.007

# RiverLevels replacement / official external level diagnostics.
PRIMARY_WATER_LEVEL_SOURCE=auto
PRIMARY_FLOOD_MONITORING_LEVEL_MEASURE_ID=5390TH-level-stage-i-15_min-mASD
PRIMARY_EA_WATER_LEVEL_MEASURE_ID=f463f458-8115-42d8-834a-c6872116737d-level-i-900-m-qualified
EA_WATER_LEVEL_MEASURE_IDS=
FLOOD_MONITORING_LEVEL_MEASURE_IDS=
FLOOD_MONITORING_READINGS_LIMIT=10000

# Water-level MQTT source. Sonar is expected roughly every 10 minutes.
WATER_MQTT_HOST=eu1.cloud.thethings.network
WATER_MQTT_PORT=8883
WATER_MQTT_TLS=1
WATER_MQTT_USERNAME=water-height-lora@ttn
WATER_MQTT_PASSWORD=
WATER_MQTT_TOPIC=v3/water-height-lora@ttn/devices/eui-a8610a3233458c03/up
# SQLite is the default operational store. The CSV path remains for automatic legacy import.
SONAR_STORAGE=sqlite
SONAR_DATABASE=data/sonar_history.sqlite3
SONAR_HISTORY_CSV=data/sonar_history.csv
SONAR_IMPORT_LEGACY_CSV=1
SONAR_CSV_MIRROR=0
PREDICTION_ARCHIVE_ENABLED=1
PREDICTION_DATABASE=data/prediction_history.sqlite3
SONAR_SENSOR_HEIGHT_M=5.0
WATER_RAW_INTERVAL_MINUTES=10
WATER_RESAMPLE_METHOD=mean
WATER_RECOMPUTE_FROM_DISTANCE=1
WATER_DISTANCE_FIELDS=distance,distance_mm,sonar_dist_mm,sonar_distance_mm
WATER_DISTANCE_UNIT=mm
SONAR_MAX_THRESHOLD_MM=4800
SONAR_DEFAULT_FALLBACK_MM=5000
SONAR_APPLY_MEDIAN_FILTER=1
SONAR_MEDIAN_FILTER_SIZE=5
SONAR_READY_MIN_COVERAGE=0.90
SONAR_READY_MIN_SPAN_HOURS=167.0
SONAR_READY_MAX_AGE_MINUTES=30
SONAR_READY_MAX_FUTURE_MINUTES=15
SONAR_ALLOW_DEGRADED_FALLBACK=1

# MQTT server used by ESP32 visualization.
PUBLISH_ENABLED=0
ALERT_MQTT_HOST=
ALERT_MQTT_PORT=8883
ALERT_MQTT_TLS=0
ALERT_MQTT_USERNAME=
ALERT_MQTT_PASSWORD=
ALERT_MQTT_TOPIC=housemill/flood/forecast

USER_AGENT=UCL-HouseMill-FloodPredictor/0.1
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1
